{
  "description": "SuperClaude hooks for session management and code formatting. Async hooks supported (v2.1.34+).",
  "schema_version": "2.1.37",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "_comment": "[superclaude] session bootstrap — hook session tracking, cleanup of sessions older than 24h, PR-review status line",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/session_init.py",
            "timeout": 10,
            "once": true
          },
          {
            "_comment": "[superclaude] warns when Claude Code memory entries are older than SUPERCLAUDE_MEMORY_STALE_DAYS (default 90); non-blocking",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/memory_staleness.py",
            "timeout": 5,
            "once": true
          }
        ]
      },
      {
        "matcher": "clear|compact|startup",
        "hooks": [
          {
            "_comment": "[superclaude] clears the context_loader dedup cache on /clear and /compact so dynamic contexts are re-injected",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/context_reset.py",
            "timeout": 5
          },
          {
            "_comment": "[superclaude] notify if pending insights from prior session",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/insight_writer.py pending-count-from-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "_comment": "[superclaude] harvest INSIGHT: markers from transcript before compaction",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/insight_writer.py harvest-from-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "_comment": "[superclaude] harvest INSIGHT: markers on /clear, /exit, logout",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/insight_writer.py harvest-from-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "_comment": "[superclaude] injects trigger-matched context (modes, MCP docs, rules) into the prompt",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/context_loader.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "_comment": "[superclaude] safety — blocks Read on files >30KB for token conservation",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/file_size_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "_comment": "[superclaude] safety — blocks destructive shell commands (Python; stdlib-only, no jq/grep/head dependency)",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/destructive_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "_comment": "[superclaude] safety — circuit breaker (SUPERCLAUDE_LOOP_GUARD=0 to disable)",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/loop_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "_comment": "[superclaude] runs prettier on edited .ts/.tsx/.js/.jsx files when prettier is available",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/prettier_hook.py",
            "timeout": 30
          },
          {
            "_comment": "[superclaude] optional — set SUPERCLAUDE_AUTO_TEST=0 to disable",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/test_runner_hook.py",
            "async": true,
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "_comment": "[superclaude] safety — circuit breaker records error/success signatures",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/loop_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "_comment": "[superclaude] ask for one INSIGHT: line when the tree changed — once per session, SUPERCLAUDE_INSIGHT_PROMPT=0 to disable",
            "type": "command",
            "command": "{{PYTHON_BIN}} {{SCRIPTS_PATH}}/insight_writer.py request-from-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
